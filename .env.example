# ===== PERSONAL AI COMPANY の設定（見本） =====
# 本番では Vercel の「Settings → Environment Variables」に入力します。
# このファイルに本物の値を書いて GitHub に上げないでください。

# Supabase のデータベース接続先（Transaction pooler の URI。パスワード部分を自分のものに置き換える）
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ログイン用パスワード（12文字以上）
APP_PASSWORD=

# ログイン状態の暗号化キー（32文字以上のでたらめな英数字）
SESSION_SECRET=

# AI（Claude）の APIキー（Anthropic のサイトで発行）
ANTHROPIC_API_KEY=

# 開発・テスト専用：1 にすると本物のAIを呼ばずにテスト用の返事をします（本番では設定しない）
# AI_MOCK=1
