# ===== PERSONAL AI COMPANY の設定（見本） =====
# 本番では Vercel の「Settings → Environment Variables」に入力します。
# このファイルに本物の値を書いて GitHub に上げないでください。
# （.env.local という名前でコピーして使うと、GitHub には上がりません）

# 【必須】Supabase のデータベース接続先（Transaction pooler の URI。[YOUR-PASSWORD] を自分のものに置き換える）
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 【必須】ログイン用パスワード（12文字以上）
APP_PASSWORD=

# 【必須】ログイン状態の暗号化キー（32文字以上のでたらめな英数字）
SESSION_SECRET=

# 【AIを使うのに必須】OpenAI の APIキー（https://platform.openai.com/api-keys で発行。sk- で始まる）
OPENAI_API_KEY=

# 開発・テスト専用：1 にすると本物のAIを呼ばずにテスト用の返事をします（本番では設定しない）
# AI_MOCK=1

# 【任意】夜間（毎日1回）にチームの作業を自動で続きから進めるための合言葉（32文字以上のでたらめな英数字）
CRON_SECRET=
